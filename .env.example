# Application environment
NODE_ENV=development

# Server configuration
HOST=0.0.0.0
PORT=3000

# Static assets
STATIC_MAX_AGE=1h
SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL connection (adjust as needed)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arabic_greeting
DB_USER=postgres
DB_PASSWORD=your_password_here

# Performance tuning
# Cache TTL (in seconds) for GET responses – default 30 seconds
CACHE_TTL_SECONDS=30
