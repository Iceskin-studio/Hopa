{
  "name": "arabic-greeting-app",
  "version": "1.3.0",
  "description": "A tiny Express server that serves a page with the Arabic greeting 'اهلا'.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "validate:api": "npx swagger-cli validate openapi.yaml",
    "lint": "eslint .",
    "test": "echo \"No tests specified\" && exit 0",
    "db:migrate": "node migrations/run.js",
    "db:seed": "node db/seed.js"
  },
  "author": "CTO",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "swagger-cli": "^4.0.4",
    "eslint": "^8.56.0"
  }
}
